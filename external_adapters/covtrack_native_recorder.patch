@@ -17,6 +17,29 @@
 from ..builder import TRACKERS, build_motion
 
+def _record_tempotrack_native_call(bboxes, labels, embeds, cls_embeds, ids, frame_id, kwargs):
+    """Optional V8 recorder; no-op unless explicitly enabled by the runner."""
+    dump_dir = os.environ.get("TEMPOTRACK_NATIVE_FEATURE_DUMP")
+    if not dump_dir or embeds is None:
+        return
+    import pathlib
+    import pickle
+    root = pathlib.Path(dump_dir)
+    root.mkdir(parents=True, exist_ok=True)
+    payload = {
+        "source": os.environ.get("TEMPOTRACK_NATIVE_FEATURE_METHOD", "covtrack"),
+        "filename": str(kwargs.get("filename", "")),
+        "frame_id": int(frame_id),
+        "bboxes": bboxes.detach().cpu().numpy(),
+        "labels": labels.detach().cpu().numpy(),
+        "embeds": embeds.detach().cpu().numpy(),
+        "cls_embeds": None if cls_embeds is None else cls_embeds.detach().cpu().numpy(),
+        "track_ids": ids.detach().cpu().numpy(),
+    }
+    with (root / f"match_calls_{os.getpid()}.pkl").open("ab") as handle:
+        pickle.dump(payload, handle, protocol=pickle.HIGHEST_PROTOCOL)
+
